# Map the @paul80nd scope to GitHub Packages so tooling knows where the private
# @paul80nd/rcasm dependency is served from. Credentials are NOT stored here:
# CI injects the token via actions/setup-node (NODE_AUTH_TOKEN), Dependabot via
# its DEPENDABOT_PACKAGES_TOKEN registry secret, and local dev via ~/.npmrc.
@paul80nd:registry=https://npm.pkg.github.com
