{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2024",
		"lib": ["ES2024"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"types": ["mocha", "node", "vscode"]
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
