{
	"name": "rcasm-lsp",
	"description": "Relay computer assembly language extension",
	"author": "Paul Law",
	"license": "MIT",
	"version": "1.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/paul80nd/rcasm-lsp"
	},
	"publisher": "paul80nd",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.100.0",
		"node": ">=20"
	},
	"main": "./client/out/extension",
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "rcasm configuration",
			"properties": {
				"languageServerRcasm.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"languageServerRcasm.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		},
		"languages": [
			{
				"id": "rcasm",
				"extensions": [
					".rcasm"
				],
				"aliases": [
					"rcasm"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "rcasm",
				"scopeName": "source.rcasm",
				"path": "./syntaxes/rcasm.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"prepublishOnly": "npm run clean",
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"esbuild:dev": "npm run esbuild -- --sourcemap",
		"esbuild:prd": "npm run esbuild -- --minify",
		"esbuild": "esbuild ./server/src/server.browser.ts --platform=browser --format=esm --target=es2020 --tsconfig=server/tsconfig.browser.json --bundle --outdir=. --entry-names=[dir]/out/[name] --external:vscode",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "jest ./server",
		"test-e2e": "sh ./scripts/e2e.sh",
		"prettier": "prettier --write ."
	},
	"overrides": {
		"serialize-javascript": "^7.0.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"jest": "^30.4.2",
		"jest-extended": "7.0.0",
		"mocha": "^11.7.6",
		"prettier": "3.9.6",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	}
}
